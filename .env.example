# ---- storage -------------------------------------------------------------
DATABASE_URL=sqlite:////app/data/preppilot.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/preppilot

# ---- auth ----------------------------------------------------------------
# generate with: openssl rand -hex 32
SECRET_KEY=dev-only-insecure-secret-change-me
JWT_DAYS=7

# ---- llm (optional) ------------------------------------------------------
# stub | gemini | groq | openai   (stub = offline: no generation, everything else works)
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# for any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter):
# LLM_BASE_URL=http://localhost:11434/v1

# ---- planner -------------------------------------------------------------
HORIZON_DAYS=28
SLOT_MINUTES=30
MAX_MINUTES_PER_DAY=240
MAX_COURSE_MINUTES_PER_DAY=150
CHURN_BONUS=400
MIN_BLOCK_SLOTS=2
SOLVER_TIME_LIMIT_S=10

# ---- demo ----------------------------------------------------------------
AUTO_SEED=true
DEMO_EMAIL=demo@preppilot.app
DEMO_PASSWORD=demo1234
